# ── Supabase ──────────────────────────────────────────────────────────────────
# Obtener en: https://supabase.com/dashboard → proyecto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your_anon_or_service_role_key

# ── Base de datos ─────────────────────────────────────────────────────────────
# Supabase (producción): obtener en Settings → Database → Connection string → URI
# SQLite (desarrollo local): sqlite:///./datos.db
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# ── OpenWeatherMap ────────────────────────────────────────────────────────────
# Obtener en: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key

# ── Configuración general ─────────────────────────────────────────────────────
APP_NAME=Closy
DEBUG=True
